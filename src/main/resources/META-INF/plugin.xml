<!--                                       />-->
<!--    </extensions>-->

<!--    <extensions defaultExtensionNs="org.jetbrains.kotlin">-->
<!--        <annotator language="kotlin" implementationClass="com.github.bukunmiola.vdetekt.MyAnnotator"/>-->
<!--        <annotator language="JAVA" implementationClass="com.github.bukunmiola.vdetekt.MyAnnotator"/>-->
<!--    </extensions>-->

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="JAVA" implementationClass="com.github.bukunmiola.vdetekt.MyAnnotator"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="kotlin" implementationClass="com.github.bukunmiola.vdetekt.KotlinAnnotator"/>
    </extensions>

</idea-plugin>
